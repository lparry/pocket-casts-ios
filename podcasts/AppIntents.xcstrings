    "siri_shortcut_set_sleep_timer_title" : {
      "comment" : "Title for the App Intent that sets the sleep timer.",
      "extractionState" : "manual",
      "localizations" : {
        "ca" : { "stringUnit" : { "state" : "translated", "value" : "Configura el temporitzador" } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Schlummerfunktion einstellen" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Set sleep timer" } },
