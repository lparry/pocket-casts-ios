        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "設定睡眠計時器" } }
      }
    },
    "Extend Sleep Timer by ${minutes} mins" : {
      "comment" : "Summary for the App Intent that extends the sleep timer. ${minutes} is the number of minutes to add.",
      "extractionState" : "manual",
      "localizations" : {
        "ca" : { "stringUnit" : { "state" : "translated", "value" : "Ampliar el temporitzador ${minutes} minuts" } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Schlummerfunktion um ${minutes} Minuten verlängern" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Extend Sleep Timer by ${minutes} mins" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Ampliar temporizador en ${minutes} minutos" } },
        "es-MX" : { "stringUnit" : { "state" : "translated", "value" : "Extender temporizador de suspensión ${minutes} minutos" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Retarder la mise en veille de ${minutes} minutes" } },
        "fr-CA" : { "stringUnit" : { "state" : "translated", "value" : "Prolonger la minuterie de veille de ${minutes} min" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Ritarda l'autospegnimento di ${minutes} minuti" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "スリープタイマーを${minutes}分延長" } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Slaaptimer verlengen met ${minutes} minuten" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Prolongar o temporizador em ${minutes} minutos" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Отложить таймер сна на ${minutes} мин." } },
        "sv" : { "stringUnit" : { "state" : "translated", "value" : "Förläng Insomningstimer med ${minutes} Minuter" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "将睡眠计时器延长 ${minutes} 分钟" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "將睡眠計時器延長 ${minutes} 分鐘" } }
