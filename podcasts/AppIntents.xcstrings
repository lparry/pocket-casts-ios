    "siri_shortcut_extend_sleep_timer_description" : {
      "comment" : "Description of the Extend Sleep Timer app intent.",
      "extractionState" : "manual",
      "localizations" : {
        "ca" : { "stringUnit" : { "state" : "translated", "value" : "Amplia el temporitzador els minuts que triïs." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Verlängert die Schlummerfunktion um eine ausgewählte Anzahl von Minuten." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Extends the sleep timer by a chosen number of minutes." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Amplía el temporizador el número de minutos que elijas." } },
        "es-MX" : { "stringUnit" : { "state" : "translated", "value" : "Extiende el temporizador de suspensión los minutos que elijas." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Retarde la mise en veille du nombre de minutes choisi." } },
        "fr-CA" : { "stringUnit" : { "state" : "translated", "value" : "Prolonge la minuterie de veille du nombre de minutes choisi." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Ritarda l'autospegnimento del numero di minuti scelto." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "スリープタイマーを選択した分数だけ延長します。" } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Verlengt de slaaptimer met een gekozen aantal minuten." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Prolonga o temporizador pelo número de minutos escolhido." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Отложить таймер сна на выбранное количество минут." } },
        "sv" : { "stringUnit" : { "state" : "translated", "value" : "Förlänger insomningstimern med valfritt antal minuter." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "将睡眠计时器延长所选的分钟数。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "將睡眠計時器延長所選的分鐘數。" } }
      }
    },
    "siri_shortcut_extend_sleep_timer_invalid_minutes_error" : {
